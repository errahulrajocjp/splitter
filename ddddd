		@Test
		@DisplayName("Should NOT add same-customerId error when target customerId is blank")
		void validateReassignNewRelatedParty_BlankTargetCustomerId_NoSameCustomerIdError() {
			// Arrange - targetCustomerId is blank; isNotBlank guard must skip the same-id check
			List<Details> errorDetailsList = new ArrayList<>();
			BulkOrderRequest bulkOrderRequest = createReassignBulkOrderRequest("123456789", "987654321");
			bulkOrderRequest.getRelatedParty().setCustomerId("242035321");
			bulkOrderRequest.getNewRelatedParty().setCustomerId(""); // blank target

			// Act
			ReflectionTestUtils.invokeMethod(bulkOrderController, "validateReassignNewRelatedParty",
					errorDetailsList, bulkOrderRequest);

			// Assert - "required" error fires, but NOT the same-id error
			assertTrue(errorDetailsList.stream().anyMatch(d ->
							OrderDomainConstants.CUSTOMER_ID.equals(d.getField())
									&& "customerId is required in newRelatedParty for Reassign order".equals(d.getIssue())),
					"Should report customerId required error for blank target");
			assertTrue(errorDetailsList.stream().noneMatch(d ->
							"Source and Target customerId cannot be same".equals(d.getIssue())),
					"Should NOT report same-customerId error when targetCustomerId is blank");
		}

