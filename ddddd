		@Test
		@DisplayName("Should add same-customerId error with correct field and value in Details object")
		void validateReassignNewRelatedParty_SameCustomerId_DetailsFieldAndValue_Correct() {
			// Arrange - verifies the Details object carries the right field name and the duplicated value
			String duplicatedCustomerId = "333444555";
			List<Details> errorDetailsList = new ArrayList<>();
			BulkOrderRequest bulkOrderRequest = createReassignBulkOrderRequest("123456789", "987654321");
			bulkOrderRequest.getRelatedParty().setCustomerId(duplicatedCustomerId);
			bulkOrderRequest.getNewRelatedParty().setCustomerId(duplicatedCustomerId);

			// Act
			ReflectionTestUtils.invokeMethod(bulkOrderController, "validateReassignNewRelatedParty",
					errorDetailsList, bulkOrderRequest);

			// Assert - field must be CUSTOMER_ID constant, value must carry the duplicated id
			Details matchingDetail = errorDetailsList.stream()
					.filter(d -> "Source and Target customerId cannot be same".equals(d.getIssue()))
					.findFirst()
					.orElse(null);
			assertNotNull(matchingDetail, "A Details entry with the same-customerId message must be present");
			assertEquals(OrderDomainConstants.CUSTOMER_ID, matchingDetail.getField(),
					"Details.field must equal OrderDomainConstants.CUSTOMER_ID");
			assertEquals(duplicatedCustomerId, matchingDetail.getValue(),
					"Details.value must carry the duplicated customerId");
		}
