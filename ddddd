@Test
		@DisplayName("Should add error when source and target customerId are exactly the same")
		void validateReassignNewRelatedParty_SameCustomerId_ExactMatch_AddsError() {
			// Arrange - source relatedParty.customerId == newRelatedParty.customerId (identical strings)
			List<Details> errorDetailsList = new ArrayList<>();
			BulkOrderRequest bulkOrderRequest = createReassignBulkOrderRequest("123456789", "987654321");
			bulkOrderRequest.getRelatedParty().setCustomerId("242035321");
			bulkOrderRequest.getNewRelatedParty().setCustomerId("242035321"); // same as source

			// Act
			ReflectionTestUtils.invokeMethod(bulkOrderController, "validateReassignNewRelatedParty",
					errorDetailsList, bulkOrderRequest);

			// Assert
			assertTrue(errorDetailsList.stream().anyMatch(d ->
							OrderDomainConstants.CUSTOMER_ID.equals(d.getField())
									&& "Source and Target customerId cannot be same".equals(d.getIssue())),
					"Should report 'Source and Target customerId cannot be same' when both customerIds are identical");
		}

		@Test
		@DisplayName("Should NOT add same-customerId error when target customerId has surrounding whitespace (no trim in comparison)")
		void validateReassignNewRelatedParty_SameCustomerId_WithWhitespace_NoError() {
			// Arrange - production code uses StringUtils.equalsIgnoreCase(sourceCustomerId, targetCustomerId)
			// WITHOUT .trim(), so "242035321" vs "  242035321  " are treated as different strings.
			// No same-customerId error should fire; only the non-numeric format error fires for the padded value.
			List<Details> errorDetailsList = new ArrayList<>();
			BulkOrderRequest bulkOrderRequest = createReassignBulkOrderRequest("123456789", "987654321");
			bulkOrderRequest.getRelatedParty().setCustomerId("242035321");
			bulkOrderRequest.getNewRelatedParty().setCustomerId("  242035321  "); // padded - not equal without trim

			// Act
			ReflectionTestUtils.invokeMethod(bulkOrderController, "validateReassignNewRelatedParty",
					errorDetailsList, bulkOrderRequest);

			// Assert - same-customerId error must NOT appear because raw strings differ
			assertTrue(errorDetailsList.stream().noneMatch(d ->
							"Source and Target customerId cannot be same".equals(d.getIssue())),
					"Should NOT report same-customerId error when target has whitespace padding and no trim is applied");
		}

